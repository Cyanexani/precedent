# Copy to .env and fill in. Never commit .env.
# Keys belong to the deployment: everyone using this deployment shares one Hindsight memory bank.

# LLM for the agent (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight memory (https://ui.hindsight.vectorize.io). For self-hosted Hindsight use http://localhost:8888 and leave the key empty.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=precedent-ap

# Comma separated origins allowed to call the API directly (the Vite dev server proxies /api, so this is rarely needed)
CORS_ORIGINS=http://localhost:5173
